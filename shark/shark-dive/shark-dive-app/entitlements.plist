<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the signed app is allowed to do, passed to block/apple-codesign-action by
  .github/workflows/release-shark-dive.yml.

  Every key here is something a JVM needs and the hardened runtime forbids by default, so a notarized
  build without them launches and immediately dies. Same set as Block's own Electron example, for the
  same reason: both ship a runtime that generates and maps executable code at runtime.

  - allow-jit / allow-unsigned-executable-memory: HotSpot compiles bytecode into memory it then executes.
  - allow-dyld-environment-variables: the launcher jpackage generates passes the JVM its own dyld paths.
  - disable-library-validation: the app loads Skia and the JDK's dylibs, which carry a different team id
    from the bundle's own signature.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
